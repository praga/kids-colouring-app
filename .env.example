# ========================================================
# Kids Colouring App Configuration
# ========================================================

# Application Port (Default: 8086)
PORT=8086
NODE_ENV=production

# NAS & Portainer Deployment (Optional, used by scripts/deploy-nas.ts)
NAS_HOST=192.168.1.25
NAS_APP_PORT=8091
PORTAINER_URL=https://192.168.1.25:31015
PORTAINER_USER=your_portainer_username
PORTAINER_PASS=your_portainer_password
CLOUDCMD_URL=http://192.168.1.25:8000
